{
  "info": {
    "name": "FitnessTracker Users API",
    "description": "Collection for testing CRUD and search operations on /v1/users",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9090"
    },
    {
      "key": "userId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "List all users (full)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/v1/users"
      }
    },
    {
      "name": "List all users (simple)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/v1/users/simple"
      }
    },
    {
      "name": "Get user by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/v1/users/{{userId}}"
      }
    },
    {
      "name": "Search users by email fragment",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/users/email?email=domain.com",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "users", "email"],
          "query": [
            {
              "key": "email",
              "value": "domain.com"
            }
          ]
        }
      }
    },
    {
      "name": "Search users born before date",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/v1/users/older/2000-01-01"
      }
    },
    {
      "name": "Create user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Mike\",\n  \"lastName\": \"Scott\",\n  \"birthdate\": \"1999-09-29\",\n  \"email\": \"mike.scott@domain.com\"\n}"
        },
        "url": "{{baseUrl}}/v1/users"
      }
    },
    {
      "name": "Update user",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Michael\",\n  \"lastName\": \"Scott\",\n  \"birthdate\": \"1999-09-29\",\n  \"email\": \"michael.scott@domain.com\"\n}"
        },
        "url": "{{baseUrl}}/v1/users/{{userId}}"
      }
    },
    {
      "name": "Delete user",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/v1/users/{{userId}}"
      }
    }
  ]
}
